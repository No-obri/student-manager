pipeline {
    agent any

    environment {
        APP_IMAGE = 'student-manager-app'
        TEST_IMAGE = 'student-manager-tests'
        CONTAINER_NAME = 'student-app-container'
        APP_PORT = '5000'
    }

    stages {

        stage('Code Linting') {
            steps {
                echo '=== Stage 1: Code Linting ==='
                sh '''
                    pip3 install flake8 --quiet --break-system-packages || pip install flake8 --quiet
                    cd student-manager
                    python3 -m flake8 app.py --max-line-length=120 --ignore=E302,W503,E501
                    echo "Linting passed successfully."
                '''
            }
        }

        stage('Code Build') {
            steps {
                echo '=== Stage 2: Building Docker Image ==='
                sh '''
                    cd student-manager
                    docker build -t ${APP_IMAGE}:${BUILD_NUMBER} -f Dockerfile .
                    docker tag ${APP_IMAGE}:${BUILD_NUMBER} ${APP_IMAGE}:latest
                    echo "Docker image built successfully."
                '''
            }
        }

        stage('Containerized Deployment') {
            steps {
                echo '=== Stage 3: Deploying Application Container ==='
                sh '''
                    docker stop ${CONTAINER_NAME} || true
                    docker rm ${CONTAINER_NAME} || true
                    docker run -d \
                        --name ${CONTAINER_NAME} \
                        -p ${APP_PORT}:5000 \
                        ${APP_IMAGE}:latest
                    sleep 5
                    echo "Application deployed on port ${APP_PORT}"
                '''
            }
        }

        stage('Containerized Selenium Testing') {
            steps {
                echo '=== Stage 4: Running Selenium Tests ==='
                sh '''
                    cd student-manager
                    docker build -t ${TEST_IMAGE}:latest -f Dockerfile.test .
                    docker run --rm \
                        --network container:${CONTAINER_NAME} \
                        ${TEST_IMAGE}:latest
                    echo "Selenium tests completed."
                '''
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed. Check logs above for errors.'
            sh '''
                docker stop ${CONTAINER_NAME} || true
                docker rm ${CONTAINER_NAME} || true
            '''
        }
        always {
            echo 'Pipeline finished.'
        }
    }
}
